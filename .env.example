# PostgreSQL (required for Vercel). Free tier: https://neon.tech
# Use the "connection string" with ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-long-random-string

# Local: http://localhost:3000
# Vercel: https://your-app.vercel.app (must match the deployed URL)
NEXTAUTH_URL=http://localhost:3000

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...
TWILIO_VERIFY_SID=VA...

RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@swiftship.in

RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# Must match the browser origin (local or Vercel URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=SwiftShip

# Optional: long random string (16+ chars). Enables POST /api/internal/seed on production
# to load demo data against the same DATABASE_URL as the running app (recommended if build seed fails).
SEED_SECRET=

# --- Vercel quick demo ---
# 1. Neon (or Vercel Postgres): set DATABASE_URL in Vercel → Environment Variables (Production + Preview + Development).
# 2. Set NEXTAUTH_SECRET, NEXTAUTH_URL, NEXT_PUBLIC_APP_URL to your https://*.vercel.app URL.
# 3. Deploy. Build runs: prisma migrate deploy && prisma db seed && next build
# 4. If tracking still shows no AWBs: add SEED_SECRET, redeploy, then once:
#    curl -X POST https://YOUR_APP.vercel.app/api/internal/seed -H "x-seed-secret: YOUR_SEED_SECRET"
#    Login: test@swiftship.in / Test@1234 — track SW2025011401 … SW2025011405
